# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/internlink?retryWrites=true&w=majority

# JWT secret for token authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:3000

# Optional: enable email password recovery with a verified sender
# Keep the API key secret in Render Environment. Never commit real credentials.
# RESEND_API_KEY=your_resend_api_key
# PASSWORD_RESET_FROM=InternLink <no-reply@your-verified-domain.example>
# PASSWORD_RESET_BASE_URL=https://team-vertex-intern-link.vercel.app
