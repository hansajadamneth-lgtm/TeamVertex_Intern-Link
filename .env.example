# Root / Global Environment Configuration Template
PORT=3000

# Express Backend Service URL
BACKEND_URL=http://localhost:5000

# MongoDB Connection String (e.g. MongoDB Atlas M0 free tier)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/internlink?retryWrites=true&w=majority

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:3000
